/*
 * WM8960 audio codec - CA7 playback via SAI1_A (audio-graph-card)
 *
 * Hardware connections:
 *   SAI1_A: PB2=SD_A(DACDAT) - data to WM8960 DAC input
 *   SAI1_B: PF7=MCLK_B, PF8=SCK_B(BCLK), PF9=FS_B(LRCLK) - clocks
 *           PF6=SD_B(ADCDAT) - data from WM8960 ADC output (not used by CA7)
 *   I2C1:   PF14=SCL, PF15=SDA  -> WM8960 control
 *
 * CA7 owns: SAI1_A (TX slave, playback via st,sync from SAI1_B) + I2C1 (codec config)
 * SAI1_B:   MCLK provider (12.288MHz) + clock master (BCLK/LRCLK generated by WM8960)
 * M4 uses:  SAI1_A (TX slave) + SAI1_B (RX master) - handled separately by M4 firmware
 */

/* audio-graph-card machine driver */
/ {
	sound_wm8960: sound {
		compatible = "audio-graph-card";
		label = "WM8960-quartzix";
		dais = <&sai1a_port>;
		widgets =
			"Headphone", "Headphone Jack",
			"Microphone", "Microphone Jack",
			"Speaker", "Left Speaker",
			"Speaker", "Right Speaker";
		routing =
			"Headphone Jack", "HP_L",
			"Headphone Jack", "HP_R",
			"LINPUT1", "Microphone Jack",
			"RINPUT1", "Microphone Jack",
			"Left Speaker", "SPK_LP",
			"Left Speaker", "SPK_LN",
			"Right Speaker", "SPK_RP",
			"Right Speaker", "SPK_RN";
	};
};

/* SAI1 parent: clocks + pinctrl + reset */
&sai1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sai1a_pins_a &sai1b_pins_a>;
	pinctrl-1 = <&sai1a_sleep_pins_a &sai1b_sleep_pins_a>;
	clocks = <&rcc SAI1>, <&rcc PLL3_Q>, <&rcc PLL3_R>;
	clock-names = "pclk", "x8k", "x11k";
	status = "okay";
};

/* SAI1_A: TX slave, borrows SAI1_B clocks via st,sync
 * Data pin: PB2 (SAI1_SD_A) -> WM8960 DACDAT
 * WM8960 is I2S master: generates BCLK/LRCLK from its MCLK input
 */
&sai1a {
	clocks = <&rcc SAI1_K>, <&sai1b>;
	clock-names = "sai_ck", "MCLK";
	dma-names = "tx";
	st,sync = <&sai1b 1>;
	status = "okay";

	sai1a_port: port {
		sai1a_endpoint: endpoint {
			remote-endpoint = <&wm8960_endpoint>;
			format = "i2s";
			mclk-fs = <256>;
			dai-tdm-slot-num = <2>;
			dai-tdm-slot-width = <16>;
		};
	};
};

/* SAI1_B: MCLK provider for WM8960 (12.288MHz)
 * Also provides BCLK/FS to SAI1_A via st,sync
 * dmas inherited from stm32mp151.dtsi but not used by CA7
 * #clock-cells = <0>: registers SAI1B as clock provider
 */
&sai1b {
	dma-names = "rx";
	#clock-cells = <0>;
	/* Force enable MCLK at boot (wm8960 driver doesn't enable it automatically) */
	assigned-clocks = <&sai1b>;
	assigned-clock-rates = <12288000>;
	status = "okay";
};

/* WM8960 on I2C1 */
&i2c1 {
	status = "okay";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c1_pins_a>;
	pinctrl-1 = <&i2c1_sleep_pins_a>;
	i2c-scl-rising-time-ns = <185>;
	i2c-scl-falling-time-ns = <20>;

	wm8960: wm8960@1a {
		compatible = "wlf,wm8960";
		reg = <0x1a>;
		#sound-dai-cells = <0>;
		clocks = <&sai1b>;
		clock-names = "mclk";
		wlf,shared-lrclk;
		status = "okay";

		port {
			wm8960_endpoint: endpoint {
				remote-endpoint = <&sai1a_endpoint>;
				/* WM8960 is master: generates BCLK and LRCLK */
				frame-master;
				bitclock-master;
			};
		};
	};
};
