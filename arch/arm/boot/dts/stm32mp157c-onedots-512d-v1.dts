/dts-v1/;

#include "stm32mp157-onedots.dtsi"
#include "stm32mp157-onedots-pinctrl.dtsi"
#include "stm32mp15xx-onedots.dtsi"

/ {
	model = "Onedots www.onedots.com.cn";
	compatible = "st,stm32mp157c-onedots-512d-v1", "st,stm32mp157";

	aliases {
		serial0 = &uart4; //debug
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

};
