/*
 * 100ASK STM32MP157 PRO carrier board with a MYIR MYC-YA157C core board.
 */

/dts-v1/;

#include <dt-bindings/rtc/rtc-stm32.h>
#include "stm32mp157a-myc-ya157c-som.dtsi"

/ {
	model = "100ASK STM32MP157A PRO Board";
	compatible = "100ask,stm32mp157a-pro", "myir,stm32mp157a-myc-ya157c", "st,stm32mp157";

	aliases {
		serial0 = &uart4;	/* debug console */
		mmc0 = &sdmmc1;		/* microSD */
		mmc1 = &sdmmc2;		/* eMMC: root=/dev/mmcblk1pN */
		mmc2 = &sdmmc3;		/* AP6236 WiFi (SDIO) */
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* 3.3 V from the carrier's MP2143DJ, always on */
	v3v3: regulator-v3v3 {
		compatible = "regulator-fixed";
		regulator-name = "v3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/*
	 * Cortex-M4 memory, laid out as on the ST DK boards and as linked by
	 * firmware/m4 (STM32MP157DACX_RAM.ld): code and data in SRAM1/SRAM2
	 * through the MCU alias at 0x10000000, the OpenAMP vrings and buffers
	 * at the start of SRAM3, the vector table in RETRAM.
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		mcuram2: mcuram2@10000000 {
			compatible = "shared-dma-pool";
			reg = <0x10000000 0x40000>;
			no-map;
		};

		vdev0vring0: vdev0vring0@10040000 {
			compatible = "shared-dma-pool";
			reg = <0x10040000 0x1000>;
			no-map;
		};

		vdev0vring1: vdev0vring1@10041000 {
			compatible = "shared-dma-pool";
			reg = <0x10041000 0x1000>;
			no-map;
		};

		vdev0buffer: vdev0buffer@10042000 {
			compatible = "shared-dma-pool";
			reg = <0x10042000 0x4000>;
			no-map;
		};

		mcuram: mcuram@30000000 {
			compatible = "shared-dma-pool";
			reg = <0x30000000 0x40000>;
			no-map;
		};

		retram: retram@38000000 {
			compatible = "shared-dma-pool";
			reg = <0x38000000 0x10000>;
			no-map;
		};
	};

	/*
	 * WM8960 audio. The codec is configured and kept powered by the M4
	 * firmware (I2C1), which also records through SAI1_B; SAI1_B is the
	 * clock master (MCLK, BCLK, LRCLK). Linux only plays through SAI1_A,
	 * synchronised to SAI1_B, so the codec appears here as a dummy DAI.
	 */
	wm8960_dac: audio-codec-dac {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0>;
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "WM8960-100ask";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&sound_codec>;
		simple-audio-card,frame-master = <&sound_codec>;

		simple-audio-card,cpu {
			sound-dai = <&sai1a>;
			dai-tdm-slot-num = <2>;
			dai-tdm-slot-width = <16>;
		};

		sound_codec: simple-audio-card,codec {
			sound-dai = <&wm8960_dac>;
		};
	};

	/* AP6236 WL_REG_ON on PI3 */
	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_pwrseq_pins_100ask>;
		reset-gpios = <&gpioi 3 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <150>;
		/* 32.768 kHz LPO, running before WL_REG_ON is released */
		clocks = <&rtc>;
		clock-names = "ext_clock";
	};
};

&pinctrl {
	/*
	 * PH4 is driven low as in the vendor 5.4 device tree; its use on
	 * the carrier is undocumented.
	 */
	wifi_pwrseq_pins_100ask: wifi-pwrseq-100ask-0 {
		pins {
			pinmux = <STM32_PINMUX('H', 4, GPIO)>;
			bias-pull-up;
			output-low;
			slew-rate = <0>;
		};
	};

	/* SAI1_SD_A: Linux playback data to WM8960 DACDAT */
	sai1a_pins_100ask: sai1a-100ask-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 2, AF6)>; /* SAI1_SD_A */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};

	sai1a_sleep_pins_100ask: sai1a-100ask-sleep-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 2, ANALOG)>; /* SAI1_SD_A */
		};
	};

	uart4_pins_100ask: uart4-100ask-0 {
		pins1 {
			pinmux = <STM32_PINMUX('A', 12, AF6)>; /* UART4_TX */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
		pins2 {
			pinmux = <STM32_PINMUX('A', 11, AF6)>; /* UART4_RX */
			bias-disable;
		};
	};

	uart4_idle_pins_100ask: uart4-100ask-idle-0 {
		pins1 {
			pinmux = <STM32_PINMUX('A', 12, ANALOG)>; /* UART4_TX */
		};
		pins2 {
			pinmux = <STM32_PINMUX('A', 11, AF6)>; /* UART4_RX */
			bias-disable;
		};
	};

	uart4_sleep_pins_100ask: uart4-100ask-sleep-0 {
		pins {
			pinmux = <STM32_PINMUX('A', 12, ANALOG)>, /* UART4_TX */
				 <STM32_PINMUX('A', 11, ANALOG)>; /* UART4_RX */
		};
	};
};

/*
 * DMA2 belongs to the M4 (SAI1_B capture runs on it, also while Linux is
 * suspended), as in ST's *-m4-examples boards. Linux keeps DMA1.
 * The DMAMUX driver numbers its channels by the order of dma-masters, and
 * DMAMUX1 channels 0-7 are wired to DMA1, 8-15 to DMA2: a list that starts
 * with DMA2 would program DMA1's mux channels, including the M4's.
 */
&dma2 {
	status = "disabled";
};

&dmamux1 {
	dma-masters = <&dma1>;
	dma-channels = <8>;
};

&gpiof {
	/*
	 * PF12 enables the SY6280 switch that would drive 5 V onto the
	 * Type-C VBUS. The OTG port is device-only (see &usbotg_hs), so keep
	 * the switch off: the host supplies VBUS.
	 */
	usb-otg-vbus-off-hog {
		gpio-hog;
		gpios = <12 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "usb-otg-vbus-en";
	};
};

&ipcc {
	status = "okay";
};

/*
 * Cortex-M4, loaded and started by Linux (remoteproc). The MCU reset and
 * hold-boot lines come from SP_MIN over SCMI (stm32mp15-sp-min-scmi.dtsi).
 * The M4 keeps running while Linux is in s2idle: its RPMsg doorbell wakes
 * Linux through the IPCC "rx" interrupt (EXTI 61, wakeup-source in
 * stm32mp151.dtsi), and wakeup-source here also arms the M4 watchdog
 * interrupt (EXTI 68) as a wake source.
 */
&m4_rproc {
	memory-region = <&retram>, <&mcuram>, <&mcuram2>, <&vdev0vring0>,
			<&vdev0vring1>, <&vdev0buffer>;
	mboxes = <&ipcc 0>, <&ipcc 1>, <&ipcc 2>;
	mbox-names = "vq0", "vq1", "shutdown";
	interrupt-parent = <&exti>;
	interrupts = <68 1>;
	wakeup-source;
	status = "okay";
};

&pwr_regulators {
	vdd-supply = <&v3v3>;
	vdd_3v3_usbfs-supply = <&v3v3>;
};

/* microSD slot */
/*
 * The AP6236 sleep clock (LPO_32K_CLK) is wired to PI8, the RTC low-speed
 * clock output on RTC_OUT2_RMP; the carrier's footprint for a separate
 * 32.768 kHz oscillator is not populated. LSCO forwards rtc_ck, which TF-A
 * clocks from the LSE crystal (CLK_RTC_LSE).
 */
&rtc {
	#clock-cells = <0>;
	st,lsco = <RTC_OUT2_RMP>;
	pinctrl-names = "default";
	pinctrl-0 = <&rtc_out2_rmp_pins_a>;
	status = "okay";
};

&sdmmc1 {
	pinctrl-names = "default", "opendrain", "sleep";
	pinctrl-0 = <&sdmmc1_b4_pins_a>;
	pinctrl-1 = <&sdmmc1_b4_od_pins_a>;
	pinctrl-2 = <&sdmmc1_b4_sleep_pins_a>;
	broken-cd;
	st,neg-edge;
	bus-width = <4>;
	vmmc-supply = <&v3v3>;
	status = "okay";
};

/*
 * SAI1: Linux owns only block A (playback). Block B and its pins
 * (PF6-PF9) are driven by the M4. The kernel clock comes from PLL3_Q
 * (24.576 MHz); the M4 firmware relies on that for MCKDIV = 2.
 */
&sai1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sai1a_pins_100ask>;
	pinctrl-1 = <&sai1a_sleep_pins_100ask>;
	clocks = <&rcc SAI1>, <&rcc PLL3_Q>, <&rcc PLL3_R>;
	clock-names = "pclk", "x8k", "x11k";
	assigned-clocks = <&rcc SAI1_K>;
	assigned-clock-parents = <&rcc PLL3_Q>;
	status = "okay";
};

&sai1a {
	dma-names = "tx";
	st,sync = <&sai1b 1>;
	status = "okay";
};

/* AP6236 WiFi (BCM43436B0), brcmfmac over SDIO */
&sdmmc3 {
	pinctrl-names = "default", "opendrain", "sleep";
	pinctrl-0 = <&sdmmc3_b4_pins_a>;
	pinctrl-1 = <&sdmmc3_b4_od_pins_a>;
	pinctrl-2 = <&sdmmc3_b4_sleep_pins_a>;
	non-removable;
	cap-power-off-card;
	cap-sdio-irq;
	keep-power-in-suspend;
	st,neg-edge;
	bus-width = <4>;
	max-frequency = <25000000>;
	vmmc-supply = <&v3v3>;
	mmc-pwrseq = <&wifi_pwrseq>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	wifi@1 {
		compatible = "brcm,bcm4329-fmac";
		reg = <1>;
		clocks = <&rtc>;
		clock-names = "lpo";
	};
};

/* debug console, routed to the carrier's USB-serial bridge */
&uart4 {
	pinctrl-names = "default", "sleep", "idle";
	pinctrl-0 = <&uart4_pins_100ask>;
	pinctrl-1 = <&uart4_sleep_pins_100ask>;
	pinctrl-2 = <&uart4_idle_pins_100ask>;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";
};

/*
 * USB host: USBH port 0 goes to a USB2514 hub (reset on PF2, pull-up not
 * fitted). Downstream: the 4G module, an RTL8152 Ethernet and two USB-A
 * sockets, all VBUS from the 5 V rail. The onboard-usb-hub driver
 * releases the reset before the hub is enumerated.
 */
&usbh_ehci {
	phys = <&usbphyc_port0>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	hub@1 {
		compatible = "usb424,2514";
		reg = <1>;
		reset-gpios = <&gpiof 2 GPIO_ACTIVE_LOW>;
		vdd-supply = <&v3v3>;
	};
};

/*
 * USB OTG on the Type-C socket, device only. The FUSB302 port controller
 * sits on I2C1, which the M4 owns for the codec, so Linux cannot run it;
 * left unconfigured it presents Rd on CC, so a host sees a device and
 * supplies VBUS. Without the controller there is no VBUS/ID detection:
 * the B-session is set through the role switch instead (userspace writes
 * "device" to /sys/class/usb_role/<...>/role, see S45usbgadget), as
 * U-Boot does with u-boot,force-b-session-valid.
 */
&usbotg_hs {
	phys = <&usbphyc_port1 0>;
	phy-names = "usb2-phy";
	dr_mode = "peripheral";
	usb-role-switch;
	role-switch-default-mode = "peripheral";
	/*
	 * Dedicated TX FIFOs, in 32-bit words. A high-speed bulk IN endpoint
	 * needs one of at least 128 words (512-byte packets); the SoC default
	 * (256 16 16 ...) has only one, so a gadget with two bulk IN endpoints
	 * (ECM + ACM, see S45usbgadget) fails with "No suitable fifo found".
	 * 352 words in total, within the 408 left after the RX and NP TX FIFOs.
	 */
	g-tx-fifo-size = <128 128 16 16 16 16 16 16>;
	status = "okay";
};

&usbphyc {
	status = "okay";
};

&usbphyc_port0 {
	phy-supply = <&v3v3>;
};

&usbphyc_port1 {
	phy-supply = <&v3v3>;
};
